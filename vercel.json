{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.tijanicsaviclegal.rs" }],
      "destination": "https://tijanicsaviclegal.rs/:path*",
      "permanent": true
    },
    { "source": "/sr", "destination": "/", "permanent": true },
    { "source": "/sr/(.*)", "destination": "/", "permanent": true },
    {
      "source": "/oblasti-prava/zastita-podata-o-licnosti-gdpr/?",
      "destination": "/oblasti-prava/zastita-podataka-o-licnosti-gdpr/",
      "permanent": true
    },
    {
      "source": "/en/oblasti-prava/zastita-podata-o-licnosti-gdpr/?",
      "destination": "/en/oblasti-prava/zastita-podataka-o-licnosti-gdpr/",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/studio/(.*)", "destination": "/studio/" }
  ]
}
