# Copy to .env.local. The same values go into the hosting configuration
# (Cloudflare Pages / Vercel), otherwise the build fails.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# The full site address, without a trailing slash. Used by the canonical links,
# hreflang and the sitemap. It may be left out locally — it falls back to
# http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
