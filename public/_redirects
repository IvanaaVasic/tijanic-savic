# Cloudflare Pages. The first rule that matches wins, so the order is not free.

# The www host is handled by a Redirect Rule on the Cloudflare zone, not here:
# Pages does not support a hostname in the source of a _redirects rule, so a
# line like "https://www.example.com/* ..." is silently ignored. The rule lives
# under Rules -> Redirect Rules and sends www to the apex with a 301.

# Serbian is the default locale and lives at the site root, with no prefix.
# /sr/ existed in an earlier version of the routing — keep the old links alive.
/sr               /            301
/sr/*             /            301

# Practice area slugs corrected after launch — the old addresses may already be
# linked or indexed.
/oblasti-prava/zastita-podata-o-licnosti-gdpr/     /oblasti-prava/zastita-podataka-o-licnosti-gdpr/     301
/oblasti-prava/zastita-podata-o-licnosti-gdpr      /oblasti-prava/zastita-podataka-o-licnosti-gdpr/     301
/en/oblasti-prava/zastita-podata-o-licnosti-gdpr/  /en/oblasti-prava/zastita-podataka-o-licnosti-gdpr/  301
/en/oblasti-prava/zastita-podata-o-licnosti-gdpr   /en/oblasti-prava/zastita-podataka-o-licnosti-gdpr/  301

# The Studio resolves its own subroutes in the browser. Without this rule F5
# inside the Studio returns a 404, even though clicking through it works.
# The target is /studio/, not /studio/index.html: with trailingSlash the latter
# is itself a 308 to /studio/, and a rewrite onto a redirect resolves to a 404.
/studio/*         /studio/     200
